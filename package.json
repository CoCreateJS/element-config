  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CoCreate-app/CoCreate-element-config/issues"
  },
  "homepage": "https://cocreate.app/docs/element-config",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/observer": "^1.21.0",
    "@cocreate/selection": "^1.16.0"
  },
  "devDependencies": {
    "@cocreate/webpack": "^1.7.0"
  },
  "allowScripts": {
    "@cocreate/observer@1.19.0": true,
    "@cocreate/selection@1.14.3": true,
    "@cocreate/utils@1.42.2": true,
    "@cocreate/webpack@1.4.3": true
  }
