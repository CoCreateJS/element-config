{
  "name": "@cocreate/element-config",
  "version": "1.18.0",
  "description": "A simple element-config component in vanilla javascript. Easily configured using HTML5 attributes and/or JavaScript API.",
  "keywords": [
    "element-config",
    "low-code",
    "realtime",
    "realtime-framework",
    "collaboration",
    "shared-editing",
    "html5-framework",
    "javascript-framework"
  ],
  "publishConfig": {
    "access": "public"
  },
  "cocreate": {
    "environment": [
      "client"
    ],
    "interface": {
      "schemaVersion": 1,
      "summary": "A simple element-config component in vanilla javascript. Easily configured using HTML5 attributes and/or JavaScript API.",
      "source": "src/index.js",
      "declarative": {
        "selectors": [
          "[config-query]",
          "config"
        ],
        "attributes": [
          {
            "name": "config"
          },
          {
            "name": "config-query"
          }
        ]
      },
      "api": {
        "exports": [
          "checkElementConfig",
          "configMatch"
        ]
      }
    }
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cocreatejs/CoCreate-element-config.git"
  },
  "author": "CoCreate LLC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CoCreate-app/CoCreate-element-config/issues"
  },
  "homepage": "https://cocreate.app/docs/element-config",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/observer": "^1.23.0",
    "@cocreate/utils": "^1.54.0"
  },
  "devDependencies": {
    "@cocreate/webpack": "^1.9.0"
  }
}
